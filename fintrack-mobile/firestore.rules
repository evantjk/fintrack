rules_version = '2';

// FinTrack security rules.
//
// Each user's data lives under users/{uid}/... . A signed-in user may only read
// and write documents under their own uid, so no account can ever see or modify
// another user's transactions or categories. Unauthenticated requests are
// denied everywhere.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
