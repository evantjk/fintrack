rules_version = '2';

// FinTrack security rules.
//
// As of the fintrack-api pivot (see ../proceeding_plan.md Stage 3),
// fintrack-api is the only writer: it talks to Firestore via the Firebase
// Admin SDK, which always bypasses these rules by design - so denying the
// client SDK entirely does not break the backend. The Flutter app no longer
// talks to Firestore directly (see HttpRepository), so there is nothing left
// that legitimately needs client-side access. Denying everything here closes
// the gap that existed while the API and the old client-write rules were
// both live at once.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
