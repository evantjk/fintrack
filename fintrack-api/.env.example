# Path to the Firebase service account JSON key file.
# Download it from: Firebase Console > Project settings > Service accounts > Generate new private key
# Keep the actual key file OUT of git (see .gitignore).
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Firebase project ID (from the Firebase console URL / project settings).
FIREBASE_PROJECT_ID=mobile-development-b86da

# Google Gemini API key for AI-generated insights (get one free at
# https://aistudio.google.com/apikey). Leave blank to fall back to the
# deterministic rule-based insights instead of calling the model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
